{
  "uid": "driving-overview",
  "title": "Driving Reservation - Overview",
  "tags": ["driving", "spring-boot", "micrometer"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(jvm_memory_used_bytes, application)",
        "refresh": 2,
        "includeAll": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP 요청률 (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"$application\"}[1m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 에러율 (5xx, req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[1m]))",
          "legendFormat": "{{status}} {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 지연 p95 / p99 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"$application\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"$application\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "JVM 힙 메모리 (used bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (id) (jvm_memory_used_bytes{application=\"$application\", area=\"heap\"})",
          "legendFormat": "{{id}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "GC 정지 시간 (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"$application\"}[1m])",
          "legendFormat": "{{action}} ({{cause}})"
        }
      ]
    },
    {
      "id": 6,
      "title": "라이브 쓰레드 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_threads_live_threads{application=\"$application\"}",
          "legendFormat": "live"
        }
      ]
    },
    {
      "id": 7,
      "title": "HikariCP 커넥션 (active/idle)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_active{application=\"$application\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_idle{application=\"$application\"}",
          "legendFormat": "idle"
        }
      ]
    },
    {
      "id": 8,
      "title": "서킷브레이커 (resilience4j · tossPayments)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "panels": []
    },
    {
      "id": 9,
      "title": "서킷 상태 (1=활성 · CLOSED/OPEN/HALF_OPEN)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "resilience4j_circuitbreaker_state{application=\"$application\", name=\"tossPayments\"}",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "실패율 % (임계 50 초과 시 OPEN)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 50, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "resilience4j_circuitbreaker_failure_rate{application=\"$application\", name=\"tossPayments\"}",
          "legendFormat": "실패율"
        }
      ]
    },
    {
      "id": 11,
      "title": "호출 결과율 (성공/실패, 건/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind) (rate(resilience4j_circuitbreaker_calls_seconds_count{application=\"$application\", name=\"tossPayments\"}[1m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "차단된 호출 (OPEN 상태 거절, 건/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(resilience4j_circuitbreaker_not_permitted_calls_total{application=\"$application\", name=\"tossPayments\"}[1m])",
          "legendFormat": "차단됨"
        }
      ]
    },
    {
      "id": 13,
      "title": "버퍼드 콜 (슬라이딩 윈도우 10건)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "resilience4j_circuitbreaker_buffered_calls{application=\"$application\", name=\"tossPayments\"}",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Kafka 웹훅 파이프라인 (payment.webhook.received)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "panels": []
    },
    {
      "id": 15,
      "title": "컨슈머 랙 (파티션별 · 밀리면 여기가 쌓인다)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "아직 소비하지 못한 레코드 수. 수신은 계속 200을 주므로 처리가 밀리는 것은 에러가 아니라 여기 숫자로 나타난다. 파티션 키가 orderId 라 특정 파티션만 쌓이면 주문 분포가 치우친 것.",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kafka_consumer_fetch_manager_records_lag{application=\"$application\", topic=\"payment.webhook.received\"}",
          "legendFormat": "파티션 {{partition}}"
        }
      ]
    },
    {
      "id": 16,
      "title": "발행 vs 소비 (건/s · 벌어지면 컨슈머가 못 따라가는 것)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(kafka_producer_topic_record_send_total{application=\"$application\", topic=\"payment.webhook.received\"}[1m]))",
          "legendFormat": "발행(수신 경로)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(kafka_consumer_fetch_manager_records_consumed_total{application=\"$application\", topic=\"payment.webhook.received\"}[1m]))",
          "legendFormat": "소비(처리 경로)"
        }
      ]
    },
    {
      "id": 17,
      "title": "DLT 격리 누적 (0이 정상)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "재시도 3회를 소진하고 payment.webhook.received.DLT 로 격리된 건수. 1건이라도 잡히면 자동 회복이 불가능했다는 뜻이므로 webhook_events 의 FAILED 레코드를 확인해야 한다.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(kafka_producer_topic_record_send_total{application=\"$application\", topic=\"payment.webhook.received.DLT\"}) or vector(0)",
          "legendFormat": "DLT"
        }
      ]
    },
    {
      "id": 18,
      "title": "발행 실패·재시도 (건/s · 브로커 이상 신호)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "발행이 실패하면 webhook_events 가 RECEIVED 로 남고, 재발행 스케줄러가 5분 뒤 회수한다.",
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(kafka_producer_topic_record_error_total{application=\"$application\", topic=\"payment.webhook.received\"}[1m]))",
          "legendFormat": "발행 실패"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(kafka_producer_topic_record_retry_total{application=\"$application\", topic=\"payment.webhook.received\"}[1m]))",
          "legendFormat": "프로듀서 재시도"
        }
      ]
    },
    {
      "id": 19,
      "title": "오프셋 커밋 지연 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "처리 성공 후에만 커밋하므로(ack-mode: record), 커밋 지연이 튀면 처리 자체가 느려진 것.",
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(kafka_consumer_coordinator_commit_latency_avg{application=\"$application\"})",
          "legendFormat": "avg"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(kafka_consumer_coordinator_commit_latency_max{application=\"$application\"})",
          "legendFormat": "max"
        }
      ]
    }
  ]
}
